{
  "name": "dsh-client-ui-review",
  "version": "1.1.1",
  "description": "Standalone turn review and project Git sidebar for the official dsh Web UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pucj0/dsh-client-ui-review.git"
  },
  "homepage": "https://github.com/pucj0/dsh-client-ui-review#readme",
  "bugs": {
    "url": "https://github.com/pucj0/dsh-client-ui-review/issues"
  },
  "scripts": {
    "check": "node scripts/check-package.mjs",
    "test": "npm run check"
  }
}
